{
  "name": "jh-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.{ts,mjs}\" \"*.{json,ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.{ts,mjs}\" \"*.{json,ts,js}\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "animate.css": "^4.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": "24.x"
  }
}
